# Copy to .env (same folder as sol_watch.py) and fill in. Keep .env private.
SOL_BRIDGE_API_KEY=sol_xxx

# Discord webhooks
# 1. Corporation (research, fleet, mining)
WEBHOOK_CORP=https://discord.com/api/webhooks/...
# 2. General (contracts, defense, global chat)
WEBHOOK_GENERAL=https://discord.com/api/webhooks/...
# 3. Alliance (alliance chat)
WEBHOOK_ALLIANCE=https://discord.com/api/webhooks/...

# Time zone for IRL timestamps (IANA name, e.g. Europe/London, America/New_York).
# Leave empty for the machine's own zone.
IRL_TIMEZONE=
