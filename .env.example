# Copy to .env (same folder as sol_watch.py) and fill in. Keep .env private.
SOL_BRIDGE_API_KEY=sol_xxx

# Discord webhook: the bridge posts everything to this one channel.
# (Before 1.09.00 it used three: WEBHOOK_CORP, WEBHOOK_GENERAL and WEBHOOK_ALLIANCE. An older .env still works:
# without WEBHOOK_BRIDGE the bridge posts to WEBHOOK_CORP, else WEBHOOK_GENERAL.)
WEBHOOK_BRIDGE=https://discord.com/api/webhooks/...
# Lite mode only (a key with just News and records and Public chat): its one channel. See the README.
# WEBHOOK_LITE=https://discord.com/api/webhooks/...

# Time zone for IRL timestamps (IANA name, e.g. Europe/London, America/New_York).
# Leave empty for the machine's own zone.
IRL_TIMEZONE=

# Other companies' valuable derelicts (abandoned craft anyone may salvage). Optional.
# How often to look, in minutes (at least 10; each look downloads ~1.3 MB). Default 60. "off" turns it off.
DERELICT_CHECK_MINUTES=
# The smallest salvage value to post, in $M. Default 0 (every derelict).
DERELICT_MIN_VALUE=
